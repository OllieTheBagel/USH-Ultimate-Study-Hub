    <!-- MODAL 3: Interactive Guided Tour Card Overlay -->
    <div id="tourOverlay" class="fixed inset-0 z-50 pointer-events-auto bg-amber-950/40 backdrop-blur-[2px] hidden flex items-end sm:items-center justify-center p-4">
        <div class="bg-cozy-cream dark:bg-cozy-darkcard border-2 border-amber-500 w-full max-w-md rounded-3xl p-5 shadow-2xl space-y-3 relative animate-bounce-short">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider" id="tourStepBadge">Step 1 of 6</span>
                <button id="skipTourBtn" class="text-xs text-amber-700 dark:text-amber-300 hover:underline" data-text-id="tour-skip">Skip Tour</button>
            </div>
            <h4 id="tourStepTitle" class="text-base font-bold text-amber-950 dark:text-amber-100 font-display">Welcome to Warm Notes Studio!</h4>
            <p id="tourStepBody" class="text-xs text-amber-900/80 dark:text-amber-200/80 leading-relaxed">
                This cozy note-taking studio helps you organize thoughts, checklists, and photo memories easily. Let's take a quick 1-minute walk-through!
            </p>
            <div class="flex items-center justify-between pt-2">
                <button id="prevTourBtn" class="px-3 py-1.5 bg-amber-100 dark:bg-amber-900/40 text-amber-900 dark:text-amber-200 text-xs font-semibold rounded-xl" data-text-id="tour-prev">Back</button>
                <button id="nextTourBtn" class="px-4 py-1.5 bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold rounded-xl shadow-md" data-text-id="tour-next">Next Step →</button>
            </div>
        </div>
    </div>

    <script>
        
        // DEFAULT SEED NOTES DATA
        const DEFAULT_NOTES = [
            {
                id: 'note-1',
                title: '✨ Welcome to Your Warm Studio',
                content: 'Create, organize, and drag your notes freely! You can attach photos with cozy borders, create checklists, and customize ANY text on screen.',
                category: 'Personal',
                status: 'todo',
                color: '#fde68a',
                pinned: true,
                createdAt: new Date().toISOString(),
                x: 40,
                y: 50,
                photo: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=500&auto=format&fit=crop&q=60',
                photoBorder: 'frame-polaroid'
            },
            {
                id: 'note-2',
                title: '✏️ Universal Text Editor',
                content: 'Click "✏️ Universal Text Editor" at the very top of the bar. Once enabled, click ANY text on screen—buttons, headers, titles—and type whatever you like!',
                category: 'Ideas',
                status: 'in-progress',
                color: '#fed7aa',
                pinned: false,
                createdAt: new Date().toISOString(),
                x: 320,
                y: 80,
                photo: '',
                photoBorder: 'frame-sunset'
            },
            {
                id: 'note-3',
                title: '☕ Sunday Coffee & Cinnamon Recipe',
                content: '1. Brew dark roast\n2. Stea milk with brown sugar\n3. Sprinkle cinnamon & honey warmth.',
                category: 'Recipes',
                status: 'done',
                color: '#fbcfe8',
                pinned: false,
                createdAt: new Date().toISOString(),
                x: 600,
                y: 120,
                photo: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=500&auto=format&fit=crop&q=60',
                photoBorder: 'frame-wooden'
            }
        ];

        // APPLICATION STATE OBJECT
        const state = {
            notes: [],
            customTextMap: {},
            universalEditMode: false,
            soundEnabled: true,
            activeView: 'grid', // 'grid' | 'canvas' | 'kanban'
            activeCategory: 'All',
            searchQuery: '',
            theme: 'warm',
            particleSpeed: 1.0,
            colorOptions: ['#fde68a', '#fed7aa', '#fbcfe8', '#c7d2fe', '#a7f3d0', '#e9d5ff']
        };

        // WEB AUDIO SYNTHESIZER FOR SOUND CHIMES
        class CozySoundEngine {
            constructor() {
                this.ctx = null;
            }

            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    if (AudioContext) {
                        this.ctx = new AudioContext();
                    }
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            playChime(type) {
                if (!state.soundEnabled) return;
                try {
                    this.init();
                    if (!this.ctx) return;

                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    if (type === 'add') {
                        // Soft ascending arpeggio
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(523.25, now); // C5
                        osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.1); // E5
                        osc.frequency.exponentialRampToValueAtTime(783.99, now + 0.2); // G5
                        gain.gain.setValueAtTime(0.15, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
                        osc.start(now);
                        osc.stop(now + 0.35);
                    } else if (type === 'delete') {
                        // Soft poof descending tone
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(440, now); // A4
                        osc.frequency.exponentialRampToValueAtTime(220, now + 0.25); // A3
                        gain.gain.setValueAtTime(0.2, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
                        osc.start(now);
                        osc.stop(now + 0.28);
                    } else if (type === 'edit') {
                        // Dual tick
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(880, now);
                        gain.gain.setValueAtTime(0.1, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
                        osc.start(now);
                        osc.stop(now + 0.1);
                    }
                } catch (e) {
                    console.log('Audio playback prevented', e);
                }
            }
        }

        const soundEngine = new CozySoundEngine();

        
        // STORAGE ENGINE
        const Storage = {
            saveNotes() {
                try {
                    localStorage.setItem('warm_notes_data', JSON.stringify(state.notes));
                } catch (e) { console.error('Save failed', e); }
            },
            loadNotes() {
                try {
                    const raw = localStorage.getItem('warm_notes_data');
                    if (raw) return JSON.parse(raw);
                } catch (e) { console.error('Load failed', e); }
                return DEFAULT_NOTES;
            },
            saveCustomText() {
                try {
                    localStorage.setItem('warm_custom_text_map', JSON.stringify(state.customTextMap));
                } catch (e) { console.error('Text map save failed', e); }
            },
            loadCustomText() {
                try {
                    const raw = localStorage.getItem('warm_custom_text_map');
                    if (raw) return JSON.parse(raw);
                } catch (e) { console.error('Text map load failed', e); }
                return {};
            }
        };

        // UNIVERSAL TEXT EDITOR ENGINE
        const UniversalTextEngine = {
            init() {
                // Apply saved custom texts to DOM elements matching data-text-id
                this.applyCustomTextMap();

                // Delegated event listener for click in Universal Edit Mode
                document.body.addEventListener('click', (e) => {
                    if (!state.universalEditMode) return;

                    // Find closest element with data-text-id or editable class
                    const target = e.target.closest('[data-text-id]');
                    if (!target) return;

                    // Prevent default action (e.g., button clicks, link navigation)
                    e.preventDefault();
                    e.stopPropagation();

                    this.makeElementEditable(target);
                }, true);
            },

            toggleMode(forceState = null) {
                state.universalEditMode = forceState !== null ? forceState : !state.universalEditMode;
                const body = document.body;
                const banner = document.getElementById('universalEditBanner');
                const tag = document.getElementById('editModeStatusTag');

                if (state.universalEditMode) {
                    body.classList.add('universal-edit-active');
                    banner.classList.remove('hidden');
                    tag.textContent = 'ON';
                    tag.className = 'bg-emerald-600 text-white text-[10px] px-1.5 py-0.5 rounded-md font-mono animate-pulse';
                    soundEngine.playChime('edit');
                } else {
                    body.classList.remove('universal-edit-active');
                    banner.classList.add('hidden');
                    tag.textContent = 'OFF';
                    tag.className = 'bg-amber-950/30 text-amber-100 text-[10px] px-1.5 py-0.5 rounded-md font-mono';
                }
            },

            makeElementEditable(el) {
                const textId = el.getAttribute('data-text-id');
                if (!textId) return;

                // Make content editable
                el.contentEditable = "true";
                el.focus();
                
                // Select all text inside
                const range = document.createRange();
                range.selectNodeContents(el);
                const sel = window.getSelection();
                sel.removeAllRanges();
                sel.addRange(range);

                const onBlur = () => {
                    el.contentEditable = "false";
                    const newText = el.innerText.trim();
                    if (newText) {
                        state.customTextMap[textId] = newText;
                        Storage.saveCustomText();
                        soundEngine.playChime('edit');
                    }
                    el.removeEventListener('blur', onBlur);
                    el.removeEventListener('keydown', onKey);
                };

                const onKey = (evt) => {
                    if (evt.key === 'Enter') {
                        evt.preventDefault();
                        el.blur();
                    } else if (evt.key === 'Escape') {
                        el.innerText = state.customTextMap[textId] || el.dataset.defaultText || el.innerText;
                        el.blur();
                    }
                };

                el.addEventListener('blur', onBlur);
                el.addEventListener('keydown', onKey);
            },

            applyCustomTextMap() {
                const elements = document.querySelectorAll('[data-text-id]');
                elements.forEach(el => {
                    const textId = el.getAttribute('data-text-id');
                    if (!el.dataset.defaultText) {
                        el.dataset.defaultText = el.innerText;
                    }
                    if (state.customTextMap[textId]) {
                        el.innerText = state.customTextMap[textId];
                    }
                });
            },

            resetAllText() {
                state.customTextMap = {};
                Storage.saveCustomText();
                const elements = document.querySelectorAll('[data-text-id]');
                elements.forEach(el => {
                    if (el.dataset.defaultText) {
                        el.innerText = el.dataset.defaultText;
                    }
                });
                soundEngine.playChime('add');
            }
        };


        // MAIN NOTE RENDER & STATE LOGIC
        const NoteEngine = {
            init() {
                state.notes = Storage.loadNotes();
                state.customTextMap = Storage.loadCustomText();
                this.renderCategories();
                this.renderAllViews();
            },

            getFilteredNotes() {
                return state.notes.filter(note => {
                    const matchesCat = state.activeCategory === 'All' || note.category === state.activeCategory;
                    const matchesSearch = !state.searchQuery || 
                        note.title.toLowerCase().includes(state.searchQuery.toLowerCase()) || 
                        note.content.toLowerCase().includes(state.searchQuery.toLowerCase());
                    return matchesCat && matchesSearch;
                }).sort((a, b) => (b.pinned ? 1 : 0) - (a.pinned ? 1 : 0));
            },

            renderCategories() {
                const container = document.getElementById('categoryFilterContainer');
                const categories = ['All', 'Personal', 'Work', 'Ideas', 'Recipes', 'Tasks'];
                
                container.innerHTML = categories.map(cat => {
                    const active = state.activeCategory === cat;
                    const activeClass = active 
                        ? 'bg-amber-500 text-white font-bold shadow-sm' 
                        : 'bg-amber-100 dark:bg-amber-900/40 text-amber-900 dark:text-amber-200 hover:bg-amber-200 dark:hover:bg-amber-800/50';
                    return `
                        <button onclick="NoteEngine.setCategory('${cat}')" class="${activeClass} px-2.5 py-1 rounded-xl text-xs transition flex items-center justify-between">
                            <span>${cat}</span>
                        </button>
                    `;
                }).join('');
            },

            setCategory(cat) {
                state.activeCategory = cat;
                this.renderCategories();
                this.renderAllViews();
            },

            // CRITICAL DELETION METHOD: Instant visual poof + clean removal
            deleteNote(id, event) {
                if (event) {
                    event.stopPropagation();
                    event.preventDefault();
                }

                // Play poof audio chime
                soundEngine.playChime('delete');

                // Find element across views and trigger poof CSS animation
                const cards = document.querySelectorAll(`[data-note-card-id="${id}"]`);
                cards.forEach(card => {
                    card.classList.add('animate-poof');
                });

                // Smooth timeout to clean up state & re-render DOM
                setTimeout(() => {
                    state.notes = state.notes.filter(n => n.id !== id);
                    Storage.saveNotes();
                    this.renderAllViews();
                }, 320);
            },

            togglePin(id, event) {
                if (event) event.stopPropagation();
                const note = state.notes.find(n => n.id === id);
                if (note) {
                    note.pinned = !note.pinned;
                    Storage.saveNotes();
                    soundEngine.playChime('edit');
                    this.renderAllViews();
                }
            },

            renderAllViews() {
                const filtered = this.getFilteredNotes();
                
                // Update Stats Counter
                document.getElementById('totalNotesCount').textContent = state.notes.length;
                document.getElementById('pinnedNotesCount').textContent = state.notes.filter(n => n.pinned).length;

                // Toggle Empty State
                const emptyState = document.getElementById('emptyState');
                if (filtered.length === 0) {
                    emptyState.classList.remove('hidden');
                    emptyState.classList.add('flex');
                } else {
                    emptyState.classList.add('hidden');
                    emptyState.classList.remove('flex');
                }

                // Render specific active view
                this.renderGridView(filtered);
                this.renderCanvasView(filtered);
                this.renderKanbanView(filtered);

                // Re-apply universal custom text mapping for dynamic components
                UniversalTextEngine.applyCustomTextMap();
            },

            createCardHtml(note, isCanvas = false) {
                const photoMarkup = note.photo ? `
                    <div class="my-2 flex justify-center">
                        <div class="${note.photoBorder || 'frame-polaroid'} max-w-full">
                            <img src="${note.photo}" alt="Attachment" class="max-h-40 w-full object-cover rounded" onerror="this.src='https://placehold.co/400x300/f59e0b/ffffff?text=Cozy+Memory'">
                        </div>
                    </div>
                ` : '';

                const pinIcon = note.pinned ? 'fa-solid fa-thumbtack text-amber-600' : 'fa-regular fa-thumbtack text-amber-800/40 hover:text-amber-600';

                return `
                    <div class="cozy-card bg-cozy-card dark:bg-cozy-darkcard p-4 rounded-2xl border border-amber-200/90 dark:border-amber-800/60 shadow-md flex flex-col justify-between relative group" 
                         style="background-color: ${note.color}15; border-top: 4px solid ${note.color};"
                         data-note-card-id="${note.id}">
                        
                        <div>
                            <!-- Card Header Bar -->
                            <div class="flex items-start justify-between gap-2 mb-2">
                                <div class="flex items-center space-x-1.5 flex-wrap">
                                    <span class="text-[10px] font-bold uppercase tracking-wider bg-amber-200/80 dark:bg-amber-900/60 text-amber-900 dark:text-amber-200 px-2 py-0.5 rounded-md">
                                        ${note.category}
                                    </span>
                                </div>
                                <div class="flex items-center space-x-2">
                                    <button onclick="NoteEngine.togglePin('${note.id}', event)" class="p-1 text-xs transition" title="Pin Note">
                                        <i class="${pinIcon}"></i>
                                    </button>
                                    <button onclick="NoteEngine.openEditModal('${note.id}', event)" class="p-1 text-xs text-amber-800/60 hover:text-amber-950 dark:text-amber-300 transition" title="Edit Note">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button onclick="NoteEngine.deleteNote('${note.id}', event)" class="p-1 text-xs text-red-600/80 hover:text-red-700 hover:scale-125 transition" title="Delete Note">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Title -->
                            <h3 class="font-bold font-display text-sm sm:text-base text-amber-950 dark:text-amber-100 mb-1 leading-snug">
                                ${note.title}
                            </h3>

                            <!-- Photo Attachment -->
                            ${photoMarkup}

                            <!-- Body Text -->
                            <p class="text-xs text-amber-900/90 dark:text-amber-200/90 whitespace-pre-line leading-relaxed mb-3">
                                ${note.content}
                            </p>
                        </div>

                        <!-- Card Footer -->
                        <div class="pt-2 border-t border-amber-200/50 dark:border-amber-800/40 flex items-center justify-between text-[10px] text-amber-800/60 dark:text-amber-400">
                            <span>${new Date(note.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}</span>
                            <span class="capitalize bg-amber-100 dark:bg-amber-900/40 px-1.5 py-0.5 rounded font-mono">${note.status}</span>
                        </div>
                    </div>
                `;
            },

            renderGridView(notes) {
                const container = document.getElementById('gridNotesList');
                if (!container) return;
                container.innerHTML = notes.map(note => this.createCardHtml(note)).join('');
            },

            renderCanvasView(notes) {
                const board = document.getElementById('canvasBoard');
                if (!board) return;

                // Retain instructions element
                const instruction = board.querySelector('[data-text-id="canvas-instruction"]').outerHTML;
                
                board.innerHTML = instruction + notes.map(note => {
                    return `
                        <div class="canvas-note w-64 absolute" 
                             style="left: ${note.x || 40}px; top: ${note.y || 50}px;"
                             data-canvas-id="${note.id}"
                             onmousedown="CanvasEngine.startDrag(event, '${note.id}')"
                             ontouchstart="CanvasEngine.startDrag(event, '${note.id}')">
                            ${this.createCardHtml(note, true)}
                        </div>
                    `;
                }).join('');
            },

            renderKanbanView(notes) {
                const statuses = ['todo', 'in-progress', 'done'];
                statuses.forEach(status => {
                    const listEl = document.getElementById(`kanbanList-${status}`);
                    const countEl = document.getElementById(`count-${status}`);
                    if (!listEl) return;

                    const statusNotes = notes.filter(n => n.status === status);
                    if (countEl) countEl.textContent = statusNotes.length;

                    listEl.innerHTML = statusNotes.map(note => `
                        <div draggable="true" ondragstart="handleKanbanDragStart(event, '${note.id}')">
                            ${this.createCardHtml(note)}
                        </div>
                    `).join('');
                });
            },

            openEditModal(id, event) {
                if (event) event.stopPropagation();
                const note = state.notes.find(n => n.id === id);
                if (!note) return;

                document.getElementById('noteId').value = note.id;
                document.getElementById('noteTitle').value = note.title;
                document.getElementById('noteCategory').value = note.category;
                document.getElementById('noteStatus').value = note.status;
                document.getElementById('noteContent').value = note.content;
                document.getElementById('photoUrlInput').value = note.photo || '';
                document.getElementById('photoBorderStyle').value = note.photoBorder || 'frame-polaroid';
                
                document.getElementById('modalHeading').textContent = 'Edit Cozy Note';
                document.getElementById('noteModal').classList.remove('hidden');
            }
        };


        // FREEFORM CANVAS DRAG ENGINE
        const CanvasEngine = {
            activeNoteId: null,
            startX: 0,
            startY: 0,
            initialLeft: 0,
            initialTop: 0,

            startDrag(e, id) {
                if (e.target.closest('button') || state.universalEditMode) return;
                
                this.activeNoteId = id;
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                
                const card = document.querySelector(`[data-canvas-id="${id}"]`);
                if (!card) return;

                this.startX = clientX;
                this.startY = clientY;
                this.initialLeft = card.offsetLeft;
                this.initialTop = card.offsetTop;

                const moveHandler = (evt) => this.onDrag(evt, card);
                const stopHandler = () => {
                    document.removeEventListener('mousemove', moveHandler);
                    document.removeEventListener('mouseup', stopHandler);
                    document.removeEventListener('touchmove', moveHandler);
                    document.removeEventListener('touchend', stopHandler);
                    
                    // Save canvas positions
                    const note = state.notes.find(n => n.id === this.activeNoteId);
                    if (note) {
                        note.x = card.offsetLeft;
                        note.y = card.offsetTop;
                        Storage.saveNotes();
                    }
                    this.activeNoteId = null;
                };

                document.addEventListener('mousemove', moveHandler);
                document.addEventListener('mouseup', stopHandler);
                document.addEventListener('touchmove', moveHandler, { passive: false });
                document.addEventListener('touchend', stopHandler);
            },

            onDrag(e, card) {
                if (!this.activeNoteId) return;
                if (e.preventDefault) e.preventDefault();
                
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;

                const dx = clientX - this.startX;
                const dy = clientY - this.startY;

                card.style.left = `${Math.max(10, this.initialLeft + dx)}px`;
                card.style.top = `${Math.max(10, this.initialTop + dy)}px`;
            }
        };

        // KANBAN DRAG & DROP HANDLERS
        function handleKanbanDragStart(e, id) {
            e.dataTransfer.setData('text/plain', id);
        }

        function allowKanbanDrop(e) {
            e.preventDefault();
        }

        function handleKanbanDrop(e, newStatus) {
            e.preventDefault();
            const id = e.dataTransfer.getData('text/plain');
            const note = state.notes.find(n => n.id === id);
            if (note && note.status !== newStatus) {
                note.status = newStatus;
                Storage.saveNotes();
                soundEngine.playChime('add');
                NoteEngine.renderAllViews();
            }
        }


        // AMBIENT BACKGROUND PARTICLE CANVAS
        const ParticleEngine = {
            canvas: null,
            ctx: null,
            particles: [],

            init() {
                this.canvas = document.getElementById('bgCanvas');
                if (!this.canvas) return;
                this.ctx = this.canvas.getContext('2d');
                this.resize();
                
                window.addEventListener('resize', () => this.resize());
                this.createParticles();
                this.animate();
            },

            resize() {
                this.canvas.width = window.innerWidth;
                this.canvas.height = window.innerHeight;
            },

            createParticles() {
                this.particles = [];
                const count = Math.floor(window.innerWidth / 25);
                for (let i = 0; i < count; i++) {
                    this.particles.push({
                        x: Math.random() * this.canvas.width,
                        y: Math.random() * this.canvas.height,
                        radius: Math.random() * 3 + 1,
                        color: `hsla(${35 + Math.random() * 20}, 90%, 60%, ${0.2 + Math.random() * 0.3})`,
                        vx: (Math.random() - 0.5) * 0.4,
                        vy: -Math.random() * 0.6 - 0.2
                    });
                }
            },

            animate() {
                this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
                
                this.particles.forEach(p => {
                    p.x += p.vx * state.particleSpeed;
                    p.y += p.vy * state.particleSpeed;

                    if (p.y < -10) p.y = this.canvas.height + 10;
                    if (p.x < -10) p.x = this.canvas.width + 10;
                    if (p.x > this.canvas.width + 10) p.x = -10;

                    this.ctx.beginPath();
                    this.ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    this.ctx.fillStyle = p.color;
                    this.ctx.fill();
                });

                requestAnimationFrame(() => this.animate());
            }
        };


        // GUIDED TOUR ENGINE
        const TourEngine = {
            step: 0,
            steps: [
                {
                    title: "Welcome to Warm Notes Studio! ☀️",
                    body: "This studio offers a cozy space for notes, checklists, and photo attachments with real-time UI customization.",
                    target: null
                },
                {
                    title: "✏️ Universal Text Editor",
                    body: "Click this button to turn on Universal Text Mode. Once ON, you can click ANY text anywhere on screen to edit it inline!",
                    target: "#toggleUniversalEditBtn"
                },
                {
                    title: "🎨 Switch Views Seamlessly",
                    body: "Easily switch between Masonry Grid, Freeform Drag & Drop Canvas, and Kanban Workflow board.",
                    target: "[data-text-id='sidebar-view-label']"
                },
                {
                    title: "📸 Add Notes & Photos",
                    body: "Create new notes with cozy custom frames like Polaroid Classic, Wooden Frame, or Sunset Glow.",
                    target: "#openNewNoteModalBtn"
                },
                {
                    title: "🗑️ Flawless Note Deletion",
                    body: "Clicking the trash icon on any card instantly triggers a warm poof effect and removes the note cleanly.",
                    target: null
                },
                {
                    title: "🎛️ Customizer Studio",
                    body: "Change themes, adjust ambient particle speed, or reset customized text anytime here!",
                    target: "#openStudioModalBtn"
                }
            ],

            start() {
                this.step = 0;
                this.showStep();
                document.getElementById('tourOverlay').classList.remove('hidden');
            },

            showStep() {
                const current = this.steps[this.step];
                document.getElementById('tourStepBadge').textContent = `Step ${this.step + 1} of ${this.steps.length}`;
                document.getElementById('tourStepTitle').textContent = current.title;
                document.getElementById('tourStepBody').textContent = current.body;

                // Clear prior highlights
                document.querySelectorAll('.tour-highlight').forEach(el => el.classList.remove('tour-highlight'));

                if (current.target) {
                    const el = document.querySelector(current.target);
                    if (el) el.classList.add('tour-highlight');
                }
            },

            next() {
                if (this.step < this.steps.length - 1) {
                    this.step++;
                    this.showStep();
                } else {
                    this.end();
                }
            },

            prev() {
                if (this.step > 0) {
                    this.step--;
                    this.showStep();
                }
            },

            end() {
                document.querySelectorAll('.tour-highlight').forEach(el => el.classList.remove('tour-highlight'));
                document.getElementById('tourOverlay').classList.add('hidden');
            }
        };


        // EVENT BINDINGS & INITIALIZATION
        window.addEventListener('DOMContentLoaded', () => {
            // Init Engines
            UniversalTextEngine.init();
            NoteEngine.init();
            ParticleEngine.init();

            // View Switcher Tabs
            document.querySelectorAll('.view-tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const view = btn.dataset.view;
                    state.activeView = view;

                    document.querySelectorAll('.view-tab-btn').forEach(b => {
                        b.classList.remove('bg-amber-500', 'text-white', 'font-semibold');
                        b.classList.add('text-amber-900', 'dark:text-amber-200');
                    });
                    btn.classList.add('bg-amber-500', 'text-white', 'font-semibold');

                    document.querySelectorAll('.view-container').forEach(c => c.classList.add('hidden'));
                    document.getElementById(`${view}View`).classList.remove('hidden');

                    soundEngine.playChime('edit');
                    NoteEngine.renderAllViews();
                });
            });

            // Universal Edit Button Toggle
            document.getElementById('toggleUniversalEditBtn').addEventListener('click', () => {
                UniversalTextEngine.toggleMode();
            });

            document.getElementById('closeEditBannerBtn').addEventListener('click', () => {
                UniversalTextEngine.toggleMode(false);
            });

            document.getElementById('resetTextBtnBanner').addEventListener('click', () => {
                UniversalTextEngine.resetAllText();
            });

            document.getElementById('resetAllTextBtnModal').addEventListener('click', () => {
                UniversalTextEngine.resetAllText();
            });

            // Guided Tour Listeners
            document.getElementById('startTourBtn').addEventListener('click', () => TourEngine.start());
            document.getElementById('skipTourBtn').addEventListener('click', () => TourEngine.end());
            document.getElementById('nextTourBtn').addEventListener('click', () => TourEngine.next());
            document.getElementById('prevTourBtn').addEventListener('click', () => TourEngine.prev());

            // Search Filter
            document.getElementById('searchInput').addEventListener('input', (e) => {
                state.searchQuery = e.target.value;
                NoteEngine.renderAllViews();
            });

            // Sound Toggle
            document.getElementById('soundToggleBtn').addEventListener('click', () => {
                state.soundEnabled = !state.soundEnabled;
                const icon = document.getElementById('soundIcon');
                icon.className = state.soundEnabled ? 'fa-solid fa-volume-high text-amber-600' : 'fa-solid fa-volume-xmark text-amber-800/40';
            });

            // Studio Modal
            document.getElementById('openStudioModalBtn').addEventListener('click', () => {
                document.getElementById('studioModal').classList.remove('hidden');
            });
            document.getElementById('closeStudioModalBtn').addEventListener('click', () => {
                document.getElementById('studioModal').classList.add('hidden');
            });

            // Theme Switcher
            document.querySelectorAll('.theme-option-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const theme = btn.dataset.theme;
                    state.theme = theme;
                    if (theme === 'dark') {
                        document.documentElement.classList.add('dark');
                    } else {
                        document.documentElement.classList.remove('dark');
                    }
                });
            });

            // Particle Speed Range
            document.getElementById('particleSpeedRange').addEventListener('input', (e) => {
                state.particleSpeed = parseFloat(e.target.value);
                document.getElementById('particleSpeedValue').textContent = `${state.particleSpeed.toFixed(1)}x`;
            });

            // Note Modal Form Handling
            const noteModal = document.getElementById('noteModal');
            document.getElementById('openNewNoteModalBtn').addEventListener('click', () => {
                document.getElementById('noteForm').reset();
                document.getElementById('noteId').value = '';
                document.getElementById('modalHeading').textContent = 'Create New Note';
                noteModal.classList.remove('hidden');
            });

            document.getElementById('emptyStateAddBtn').addEventListener('click', () => {
                document.getElementById('noteForm').reset();
                document.getElementById('noteId').value = '';
                noteModal.classList.remove('hidden');
            });

            document.getElementById('closeNoteModalBtn').addEventListener('click', () => noteModal.classList.add('hidden'));
            document.getElementById('cancelNoteModalBtn').addEventListener('click', () => noteModal.classList.add('hidden'));

            // Render Color Picker Buttons
            const colorContainer = document.getElementById('colorPickerContainer');
            let selectedColor = state.colorOptions[0];
            colorContainer.innerHTML = state.colorOptions.map((c, i) => `
                <button type="button" onclick="selectedColor='${c}'" class="w-7 h-7 rounded-full border-2 border-white shadow hover:scale-110 transition" style="background-color: ${c}"></button>
            `).join('');

            // Photo FileReader Attachment
            let attachedPhotoBase64 = '';
            document.getElementById('photoFileInput').addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (evt) => {
                        attachedPhotoBase64 = evt.target.result;
                        document.getElementById('photoPreviewImg').src = attachedPhotoBase64;
                        document.getElementById('photoPreviewContainer').classList.remove('hidden');
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Note Form Submit
            document.getElementById('noteForm').addEventListener('submit', (e) => {
                e.preventDefault();
                const id = document.getElementById('noteId').value || `note-${Date.now()}`;
                const title = document.getElementById('noteTitle').value;
                const category = document.getElementById('noteCategory').value;
                const status = document.getElementById('noteStatus').value;
                const content = document.getElementById('noteContent').value;
                const photoUrl = attachedPhotoBase64 || document.getElementById('photoUrlInput').value;
                const photoBorder = document.getElementById('photoBorderStyle').value;

                const existingIndex = state.notes.findIndex(n => n.id === id);
                const noteObj = {
                    id,
                    title,
                    category,
                    status,
                    content,
                    color: selectedColor,
                    pinned: existingIndex >= 0 ? state.notes[existingIndex].pinned : false,
                    createdAt: existingIndex >= 0 ? state.notes[existingIndex].createdAt : new Date().toISOString(),
                    x: existingIndex >= 0 ? state.notes[existingIndex].x : 40 + Math.random() * 200,
                    y: existingIndex >= 0 ? state.notes[existingIndex].y : 50 + Math.random() * 100,
                    photo: photoUrl,
                    photoBorder: photoBorder
                };

                if (existingIndex >= 0) {
                    state.notes[existingIndex] = noteObj;
                } else {
                    state.notes.unshift(noteObj);
                }

                Storage.saveNotes();
                soundEngine.playChime('add');
                NoteEngine.renderAllViews();
                noteModal.classList.add('hidden');
                attachedPhotoBase64 = '';
            });
        });
    </script>
</body>
</html>
